@page "/"
@implements IDisposable
@using Microsoft.Extensions.Options

<PageTitle>Checker Fleet</PageTitle>

<div class="fleet-top-bar">
    <div>
        <span class="fleet-title">Checker Remote Bridge</span>
        <span class="fleet-subtitle">@FinalCount Pi accessed over OPC UA via KepServerEX</span>
    </div>
    <div class="fleet-top-meta">
        <span class="fleet-server-badge">
            <span class="fleet-live-dot"></span>@ServerDisplayName
        </span>
        <span class="fleet-clock">@ClockText</span>
    </div>
</div>

@if (!ActionService.SshConfigured)
{
    <div class="fleet-opc-warning d-block">
        SSH is not configured. Set FINAL_USER FINAL_PASS, and FINALN_IP (with optional FINALN_USER and FINALN_PASS as overrides, e.g. FINAL2_USER) to enable checksums and remote launch capability.
    </div>
}

<div class="fleet-grid">
    @for (int i = 1; i <= FinalCount; i++)
    {
        int finalId = i;
        CheckerStatus status = StateStore.Get(finalId);
        HealthState health = HealthEvaluator.Evaluate(status, Now, WatchdogStaleSeconds);
        <CheckerStationCard FinalId="finalId"
                            Status="status"
                            Health="health"
                            Now="Now"
                            Selected="finalId == SelectedFinalId"
                            OnSelected="SelectFinal" />
    }
</div>

<div class="fleet-section">
    <div class="fleet-section-head">
        <span>Final @SelectedFinalId — control panel</span>
    </div>
    <CheckerDetailPanel FinalId="SelectedFinalId"
                        Status="StateStore.Get(SelectedFinalId)"
                        Health="HealthEvaluator.Evaluate(StateStore.Get(SelectedFinalId), Now, WatchdogStaleSeconds)"
                        Now="Now"
                        WatchdogStaleSeconds="WatchdogStaleSeconds"
                        OpcConfigured="ActionService.OpcConfigured"
                        OnReboot="ConfirmReboot"
                        OnShutdown="ConfirmShutdown"
                        OnLaunch="ConfirmLaunch" />
</div>

<div class="fleet-status-strip">
    <span class="fleet-legend-title">Health:</span>
    <span class="fleet-legend-item"><span class="fleet-dot" style="background:#198754"></span>Green: &lt;@WatchdogStaleSeconds s since update, no alarm</span>
    <span class="fleet-legend-item"><span class="fleet-dot" style="background:#dc3545"></span>Red: &gt;@WatchdogStaleSeconds s since update or alarm active</span>
    <span class="fleet-legend-item"><span class="fleet-dot" style="background:#64748b"></span>Offline: Pi not running checker</span>
    <span class="fleet-legend-item"><span class="fleet-dot" style="background:#0dcaf0"></span>Busy: Stopping/starting checker</span>
</div>

<ConfirmActionModal IsOpen="modalOpen"
                    Title="@modalTitle"
                    Body="@modalBody"
                    ConfirmLabel="@modalConfirmLabel"
                    ConfirmClass="@modalConfirmClass"
                    OnConfirm="ExecuteModalAction"
                    OnCancel="CloseModal" />

@code {
    [Inject]
    private CheckerStateStore StateStore { get; set; } = default!;

    [Inject]
    private CheckerActionService ActionService { get; set; } = default!;

    [Inject]
    private IOptions<CheckerFleetOptions> FleetOptions { get; set; } = default!;

    private int FinalCount => FleetOptions.Value.FinalCount;
    private string ServerDisplayName => FleetOptions.Value.ServerDisplayName;
    private int WatchdogStaleSeconds => FleetOptions.Value.WatchdogStaleSeconds;

    private int SelectedFinalId { get; set; } = 1;
    private DateTime Now { get; set; } = DateTime.Now;
    private string ClockText { get; set; } = string.Empty;

    private bool modalOpen;
    private string modalTitle = string.Empty;
    private string modalBody = string.Empty;
    private string modalConfirmLabel = "Confirm";
    private string modalConfirmClass = string.Empty;
    private Func<Task>? pendingAction;

    private readonly HashSet<int> launchedStationIds = new();
    private readonly SemaphoreSlim launchLock = new(1, 1);
    private bool startupEvaluationComplete = false;

    protected override void OnInitialized()
    {
        StateStore.StatusChanged += OnStatusChanged;
        StateStore.StatusChanged += OnStatusChangedForStartup;

        UpdateClock();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _ = RunClockLoop();
        _ = RunWatchdogLoop();
        await TryRunStartupEvaluationAsync();
    }

    private void OnStatusChanged(int _) => InvokeAsync(StateHasChanged);

    private void OnStatusChangedForStartup(int finalId)
    {
        if (startupEvaluationComplete)
        {
            return;
        }

        _ = Task.Run(async () => await TryRunStartupEvaluationAsync(finalId));
    }

    private async Task TryRunStartupEvaluationAsync(int? finalId = null)
    {
        if (startupEvaluationComplete)
        {
            return;
        }

        await launchLock.WaitAsync();
        try
        {
            IEnumerable<int> stationIds = finalId is null
                ? Enumerable.Range(1, FinalCount)
                : new[] { finalId.Value };

            foreach (int stationId in stationIds)
            {
                if (startupEvaluationComplete || launchedStationIds.Contains(stationId))
                {
                    continue;
                }

                CheckerStatus status = StateStore.Get(stationId);
                if (string.IsNullOrWhiteSpace(status.ExpectedChecksum))
                {
                    continue;
                }

                launchedStationIds.Add(stationId);
                await ActionService.CheckAndLaunchAsync(stationId);

                if (launchedStationIds.Count >= FinalCount)
                {
                    startupEvaluationComplete = true;
                    StateStore.StatusChanged -= OnStatusChangedForStartup;
                    System.Diagnostics.Debug.WriteLine("Successfully unsubscribed from startup launch handler.");
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error launching station {finalId ?? 0}: {ex.Message}");
        }
        finally
        {
            launchLock.Release();
        }
    }

    private void SelectFinal(int finalId) => SelectedFinalId = finalId;

    private void ConfirmLaunch(int finalId) =>
        OpenModal(
            $"Auto-launch Final {finalId}",
            $"Connects to the Pi runnning checker {finalId} to run the checksum and checker launch script.",
            "Launch",
            "confirm-launch",
            async () => await ActionService.CheckAndLaunchAsync(finalId));

    private void ConfirmReboot(int finalId) =>
        OpenModal(
            $"Reboot Final {finalId}",
            "Creates a <strong>RebootRequest</strong> for the checker to shut down and restart.",
            "Confirm reboot",
            "confirm-warn",
            async () => await ActionService.RequestRebootAsync(finalId));

    private void ConfirmShutdown(int finalId) =>
        OpenModal(
            $"Shut down Final {finalId}",
            "Creates <strong>ShutdownRequest</strong> for the checker to close gracefully.",
            "Confirm shutdown",
            "confirm-danger",
            async () => await ActionService.RequestShutdownAsync(finalId));

    private void OpenModal(string title, string body, string confirmLabel, string confirmClass, Func<Task> action)
    {
        modalTitle = title;
        modalBody = body;
        modalConfirmLabel = confirmLabel;
        modalConfirmClass = confirmClass;
        pendingAction = action;
        modalOpen = true;
    }

    private void CloseModal()
    {
        modalOpen = false;
        pendingAction = null;
    }

    private async Task ExecuteModalAction()
    {
        if (pendingAction is not null)
        {
            await pendingAction();
        }

        CloseModal();
    }

    private async Task RunClockLoop()
    {
        using PeriodicTimer timer = new(TimeSpan.FromSeconds(1));
        while (await timer.WaitForNextTickAsync())
        {
            UpdateClock();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunWatchdogLoop()
    {
        using PeriodicTimer timer = new(TimeSpan.FromSeconds(1));
        while (await timer.WaitForNextTickAsync())
        {
            Now = DateTime.Now;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateClock()
    {
        DateTime now = DateTime.Now;
        ClockText = $"{now:MMM d} {now:HH:mm:ss}";
    }

    public void Dispose()
    {
        StateStore.StatusChanged -= OnStatusChanged;

        // Handle the case where the page is disposed before OPC is fully set up.
        if (!startupEvaluationComplete)
        {
            StateStore.StatusChanged -= OnStatusChangedForStartup;
        }

        this.launchLock.Dispose();
    }
}
